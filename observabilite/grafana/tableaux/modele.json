  {
   "id": 6,
   "title": "Requêtes par seconde",
   "description": "",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum by (route) (rate(requetes_total{service=\"api-score\"}[5m]))",
     "legendFormat": "{{route}}"
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 9
   },
   "options": {},
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   }
  },
  {
   "id": 7,
   "title": "Latence (95e centile)",
   "description": "",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, route) (rate(duree_requete_secondes_bucket{service=\"api-score\"}[5m])))",
     "legendFormat": "{{route}}"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "options": {},
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "title": "Part d'erreurs",
   "description": "",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum(rate(requetes_total{service=\"api-score\",code=~\"[45]..\"}[5m])) / sum(rate(requetes_total{service=\"api-score\"}[5m]))",
     "legendFormat": "erreurs"
    }
   ],
   "gridPos": {
    "x": 12,
    "y": 13,
    "w": 12,
    "h": 8
   },
   "options": {},
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "title": "Historique des mesures de surveillance",
   "description": "",
   "type": "table",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "supervision"
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "supervision"
     },
     "refId": "A",
     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT to_char(date_mesure, 'YYYY-MM-DD') AS \"Date\", version AS \"Version\", indicateur AS \"Indicateur\", valeur AS \"Valeur\", statut AS \"Statut\" FROM supervision.modele_surveillance ORDER BY date_mesure DESC, indicateur LIMIT 60"
    }
   ],
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 24,
    "h": 9
   },
   "options": {},
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  }
 ]
}