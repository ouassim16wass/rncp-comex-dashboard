  {
   "id": 3,
   "title": "Dérive maximale",
   "description": "Indice de stabilité de population : moins de 0,1 stable, de 0,1 à 0,25 à surveiller, au-delà dérive forte.",
   "type": "stat",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "max(modele_psi)",
     "legendFormat": ""
    }
   ],
   "gridPos": {
    "x": 10,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "options": {},
   "fieldConfig": {
    "defaults": {
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
