FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir fastapi==0.165.0 uvicorn==0.54.0 pandas==3.1.1 openpyxl==3.1.5 pyarrow==26.0.1 PyYAML==6.0.4 prometheus-client==0.26.0
COPY src/lecture.py src/api_simulee.py src/metriques.py src/journal.py src/
EXPOSE 8110
CMD ["uvicorn", "api_simulee:app", "--app-dir", "src", "--host", "0.0.0.0", "--port", "8110"]
