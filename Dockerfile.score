FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir fastapi==0.165.0 uvicorn==0.54.0 pandas==3.1.1 numpy==2.5.5 scikit-learn==1.9.1 joblib==1.6.0 "psycopg[binary]==3.3.9" prometheus-client==0.26.0
COPY src/risque.py src/api_score.py src/registre.py src/journal.py src/metriques.py src/
ENV PYTHONPATH=/app/src
EXPOSE 8120
CMD ["uvicorn", "api_score:app", "--host", "0.0.0.0", "--port", "8120"]
